{
  "name": "yumunio-app",
  "version": "0.1.0",
  "description": "A Tauri client for your self-hosted Yumunio workspace.",
  "private": true,
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/KuronekoServer/Yumunio-App.git"
  },
  "engines": {
    "node": ">=24.16.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "check": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "build": "npm run check && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "tauri": "tauri",
    "app:dev": "tauri dev",
    "app:build": "tauri build",
    "android:init": "node scripts/initialize-mobile.mjs android",
    "android:dev": "tauri android dev",
    "android:build": "tauri android build",
    "ios:init": "node scripts/initialize-mobile.mjs ios",
    "ios:dev": "tauri ios dev",
    "ios:build": "tauri ios build"
  },
  "dependencies": {
    "@tauri-apps/api": "2.12.4"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.12.3",
    "prettier": "3.9.10",
    "typescript": "7.0.2",
    "vite": "8.3.4"
  }
}
